{
  "name": "keepvocab",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "description": "A local-first vocabulary gym with Google Drive backup.",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test",
    "start": "python3 -m http.server 8085 --bind 127.0.0.1",
    "build:web": "node scripts/build-web.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "mac:dev": "npm run build:web && electron .",
    "mac:build": "npm run build:web && electron-builder --mac dmg zip --universal"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/local-notifications": "^8.3.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.keepvocab.app",
    "productName": "KeepVocab",
    "asar": {
      "smartUnpack": false
    },
    "directories": {
      "output": "dist/macos",
      "buildResources": "resources"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "package.json",
      "!node_modules/@capacitor/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "resources/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KeepVocab uses the microphone when you start a speaking exercise.",
        "NSSpeechRecognitionUsageDescription": "KeepVocab uses speech recognition when you choose voice input."
      }
    },
    "dmg": {
      "artifactName": "KeepVocab-${version}-macOS-${arch}.${ext}",
      "title": "KeepVocab ${version}",
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 400,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RODIONOLIINYK",
        "repo": "KeepVocab",
        "releaseType": "release"
      }
    ]
  }
}
